# 운영 서버 환경 변수. 서버의 /etc/portfolio/portfolio.env 에 둔다(권한 640, root:portfolio).
# server-setup.sh 가 이 파일을 복사하고 SESSION_SECRET, ANALYTICS_SECRET 은 임의 값으로 채운다.
# 비어 있는 값(CONTACT_TO, SMTP_PASS, ADMIN_*)만 채우면 된다. 수정 후: sudo systemctl restart portfolio
# 형식: 이름="값" 한 줄에 하나. NODE_ENV, PORT, HOSTNAME 은 portfolio.service 에 있으므로 넣지 않는다.

DATABASE_URL="file:/var/lib/portfolio/db/portfolio.db"
UPLOAD_DIR="/var/lib/portfolio/uploads"
SITE_URL="https://fillddak.kr"

# 문의를 받을 주소
CONTACT_TO=""
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
# Resend 에서 발급한 API 키(re_...)
SMTP_PASS=""
SMTP_FROM="contact@fillddak.kr"

ADMIN_USERNAME=""
# 내 PC 에서 npm run hash-password 로 만든 값
ADMIN_PASSWORD_HASH_B64=""
SESSION_SECRET=""
ANALYTICS_SECRET=""

# 앞단 프록시가 Nginx 하나
TRUSTED_PROXY_HOPS="1"
PAGEVIEW_RETENTION_DAYS="180"

TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
