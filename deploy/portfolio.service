# 포트폴리오 앱(Next.js standalone). 설치 위치: /etc/systemd/system/portfolio.service
# 배포할 때마다 /opt/portfolio/current 가 새 버전을 가리키고, 배포 스크립트가 이 서비스를 재시작한다.
[Unit]
Description=Portfolio (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/portfolio/current
# 비밀값을 포함한 환경 변수. 아래 Environment 의 세 값은 이 파일에 넣지 않는다.
EnvironmentFile=/etc/portfolio/portfolio.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Nginx 만 접속하도록 외부가 아닌 로컬 주소에서만 받는다.
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node /opt/portfolio/current/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# 메모리 1GB 서버: 앱 목표 250MB. 넘기면 먼저 회수하고(High), 그래도 넘으면 종료 후 재시작(Max).
MemoryHigh=320M
MemoryMax=450M

# 새로 만드는 파일은 portfolio 그룹까지만 읽을 수 있다(Nginx 는 이 그룹에 들어 있어 업로드 이미지를 읽는다).
UMask=0027

# 앱이 쓸 수 있는 곳은 데이터 폴더와 배포 폴더(Next.js 캐시)뿐이다.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/portfolio /opt/portfolio/releases
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
