# ── 기본 ────────────────────────────────────────────────
# SQLite 파일 경로. 운영에서는 배포 폴더 밖에 둔다. 예: file:/var/lib/portfolio/portfolio.db
DATABASE_URL="file:./data/dev.db"
# 업로드 파일(이미지, PDF) 저장 경로. 운영 예: /var/lib/portfolio/uploads
UPLOAD_DIR="./data/uploads"
# 사이트 주소 (끝에 슬래시 없이). 운영: https://fillddak.kr
SITE_URL="http://localhost:3000"

# ── 문의 메일 ───────────────────────────────────────────
# 문의를 받을 주소. 화면과 클라이언트 코드에는 노출되지 않는다.
CONTACT_TO=""
#
# [A] 메일 발송 서비스 + 내 도메인 (권장). 아래는 Resend 기준
#   SMTP_HOST="smtp.resend.com"  SMTP_PORT="465"
#   SMTP_USER="resend"           (모든 계정이 같은 고정 아이디)
#   SMTP_PASS="re_..."           (Resend 에서 발급한 API 키)
#   SMTP_FROM="contact@fillddak.kr" (Resend 에서 인증한 도메인의 주소)
#
# [B] 네이버 SMTP. 2단계 인증을 켜고 발급한 애플리케이션 비밀번호가 필요하다
#   SMTP_HOST="smtp.naver.com"   SMTP_PORT="465"
#   SMTP_USER="아이디@naver.com"  SMTP_PASS="애플리케이션 비밀번호"  SMTP_FROM="" (비워 둠)
SMTP_HOST="smtp.resend.com"
# 465(SSL) 또는 587(STARTTLS)
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# 보낸 사람 주소. 비우면 SMTP_USER 를 쓴다
SMTP_FROM=""

# ── 관리자 ──────────────────────────────────────────────
ADMIN_USERNAME=""
# `npm run hash-password` 로 만든 값 (bcrypt 해시를 base64로 인코딩)
ADMIN_PASSWORD_HASH_B64=""
# 각각 32자 이상의 임의 문자열. 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
ANALYTICS_SECRET=""

# ── 통계 ────────────────────────────────────────────────
# 앱 앞의 신뢰할 수 있는 프록시 수. Nginx 하나면 1, 로컬 개발처럼 프록시가 없으면 0
TRUSTED_PROXY_HOPS="0"
# 조회 상세 로그 보관 일수
PAGEVIEW_RETENTION_DAYS="180"

# ── 선택: Cloudflare Turnstile (둘 다 채우면 문의 폼에 켜진다) ──
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

