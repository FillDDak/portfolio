generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 사이트 소유자 정보. 항상 id = 1 인 한 행만 존재한다.
model Profile {
  id              Int       @id @default(1)
  name            String
  jobTitle        String
  tagline         String
  bio             String    @default("")
  /// 첫 화면에 보여줄 핵심 스택. 쉼표로 구분한 문자열
  coreStack       String    @default("")
  githubUrl       String    @default("")
  velogUrl        String    @default("")
  notionUrl       String    @default("")
  /// 문의 섹션에 공개하는 메일 주소. 비우면 표시하지 않는다(문의 폼의 수신 주소는 환경 변수 CONTACT_TO 로 따로 둔다)
  contactEmail    String    @default("")
  /// 업로드된 PDF의 서버 파일명. 없으면 null
  resumeFile      String?
  resumeUpdatedAt DateTime?
  /// 첫 화면에 보여 줄 프로필 사진(업로드 폴더 images 안의 서버 파일명, 정사각형 webp). 없으면 null
  photoFile       String?
  /// 자르기 전 원본(긴 변 1600px 이하 webp). 보이는 부분을 다시 고를 때 여기서 잘라 photoFile 을 새로 만든다
  photoSourceFile String?
  /// 원본에서 보이는 정사각형의 가운데 위치(0~1, 원본 너비·높이 기준)와 확대 배율(1~3)
  photoFocusX     Float     @default(0.5)
  photoFocusY     Float     @default(0.5)
  photoZoom       Float     @default(1)
  updatedAt       DateTime  @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  summary     String
  role        String   @default("")
  teamSize    Int      @default(1)
  /// YYYY-MM
  startDate   String
  /// YYYY-MM. 진행 중이면 null
  endDate     String?
  /// 카드에 보여줄 핵심 성과(수치). 한 줄에 하나씩
  highlights  String   @default("")
  /// Markdown 본문 (문제 → 해결 → 결과)
  body        String   @default("")
  coverImage  String?
  demoUrl     String   @default("")
  githubUrl   String   @default("")
  docsUrl     String   @default("")
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags        ProjectTag[]
  images      ProjectImage[]
  experiences Experience[]
  posts       Post[]

  @@index([isPublished, isFeatured, sortOrder])
}

model ProjectTag {
  id        Int     @id @default(autoincrement())
  projectId Int
  name      String
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int
  file      String
  alt       String  @default("")
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SkillCategory {
  id        Int     @id @default(autoincrement())
  name      String
  sortOrder Int     @default(0)
  skills    Skill[]
}

model Skill {
  id         Int           @id @default(autoincrement())
  categoryId Int
  name       String
  /// USED(실무·프로젝트 사용) | LEARNED(학습 경험)
  level      String        @default("USED")
  sortOrder  Int           @default(0)
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Certificate {
  id         Int    @id @default(autoincrement())
  name       String
  issuer     String
  /// YYYY-MM-DD
  acquiredAt String
  sortOrder  Int    @default(0)
}

/// 경험(학력·교육·활동·수상). 공개 페이지에서는 종류별로 묶고, 각 묶음 안에서는 최근 것부터 보여 준다.
model Experience {
  id          Int      @id @default(autoincrement())
  /// EDUCATION(학력) | TRAINING(교육) | ACTIVITY(활동) | AWARD(수상)
  kind        String
  /// 학교, 교육기관, 활동, 상 이름
  title       String
  /// 전공·과정명·역할 등. 없으면 빈 문자열
  subtitle    String   @default("")
  /// YYYY-MM. 수상은 받은 달
  startDate   String
  /// YYYY-MM. 비어 있으면 진행 중(수상은 쓰지 않음)
  endDate     String   @default("")
  description String   @default("")
  /// 이 경험에서 만든 프로젝트. 프로젝트를 지우면 연결만 끊긴다.
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([kind])
}

/// 글(트러블슈팅, 개발 노트). 프로젝트에 연결하면 그 프로젝트 상세 페이지에도 목록으로 보인다.
model Post {
  id          Int      @id @default(autoincrement())
  /// TROUBLESHOOTING(트러블슈팅) | NOTE(개발 노트)
  category    String
  title       String
  slug        String   @unique
  /// 목록 카드에 보여 줄 한두 줄 요약
  summary     String
  /// Markdown 본문
  body        String   @default("")
  /// 쉼표로 구분한 기술 태그
  tags        String   @default("")
  /// 글에 표시하는 날짜(YYYY-MM-DD). 목록은 이 날짜의 최신순
  date        String
  isPublished Boolean  @default(false)
  /// 관련 프로젝트. 프로젝트를 지우면 연결만 끊긴다.
  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, date])
  @@index([projectId])
}

/// 상태 페이지에서 감시할 URL. 공개 페이지에는 주소를 글자로 보여 주지 않고 '방문' 버튼의 링크로만 쓴다.
model Monitor {
  id          Int     @id @default(autoincrement())
  name        String
  /// 어떤 서비스인지 한 줄 설명(상태 페이지에 이름 아래 표시)
  description String  @default("")
  url         String
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model ContactMessage {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  organization String   @default("")
  subject      String
  body         String
  isRead       Boolean  @default(false)
  /// PENDING | SENT | FAILED
  mailStatus   String   @default("PENDING")
  mailError    String   @default("")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// 조회 상세 로그. 보관 기간(기본 180일)이 지나면 삭제된다. IP 원문은 저장하지 않는다.
model PageView {
  id             Int      @id @default(autoincrement())
  path           String
  /// 프로젝트 상세 조회일 때만 값이 있다
  projectId      Int?
  /// sha256(일별 솔트 + IP + User-Agent)
  visitorHash    String
  /// 유입 사이트의 도메인만. 직접 접속이면 빈 문자열
  referrerDomain String   @default("")
  utmSource      String   @default("")
  /// desktop | mobile | tablet
  device         String
  /// "Chrome 142" 처럼 이름과 주 버전. 모르면 빈 문자열
  browser        String   @default("")
  /// "iOS 26.1", "Windows 11" 등. 모르면 빈 문자열
  os             String   @default("")
  /// 안드로이드 모델 코드, iPhone, iPad. 모르면 빈 문자열
  model          String   @default("")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([visitorHash, path, createdAt])
}

/// 일별 집계. 상세 로그가 삭제된 뒤에도 계속 보관한다.
model DailyStat {
  id        Int    @id @default(autoincrement())
  /// Asia/Seoul 기준 YYYY-MM-DD
  date      String
  path      String
  projectId Int?
  views     Int    @default(0)
  visitors  Int    @default(0)

  @@unique([date, path])
  @@index([projectId, date])
}

/// 콘텐츠 반응 집계(섹션 도달, 카드·링크 클릭, PDF 열람, 문의 작성). 날짜·항목별 횟수만 남기고 방문자 정보는 저장하지 않는다.
model EventStat {
  id     Int    @id @default(autoincrement())
  /// Asia/Seoul 기준 YYYY-MM-DD
  date   String
  /// home | section | card | link | pdf | contact
  event  String
  /// 예: section → "projects", card → 프로젝트 id, link → "profile:github" / "project:3:docs"
  target String @default("")
  count  Int    @default(0)

  @@unique([date, event, target])
  @@index([event, date])
}

/// 관리자 로그인 기록(성공, 실패, 잠김). 보안 확인용이라 IP 원문을 저장하고, 보관 기간(90일)이 지나면 삭제한다.
model LoginAttempt {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  /// SUCCESS | FAILURE | LOCKED
  result     String
  ip         String
  userAgent  String   @default("")
  /// 브라우저가 알려 준 기기 정보(JSON, src/lib/device/describe.ts 의 ClientInfo)
  clientInfo String   @default("{}")
  /// 같은 기기를 묶어 보기 위한 짧은 값(기기 정보의 해시). 정보를 받지 못했으면 빈 문자열
  deviceId   String   @default("")
  /// 위치 조회 결과. 조회 전이거나 실패하면 빈 값
  country    String   @default("")
  region     String   @default("")
  city       String   @default("")
  isp        String   @default("")
  /// PENDING | OK | PRIVATE(내부 주소라 조회 안 함) | FAILED
  geoStatus  String   @default("PENDING")

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([deviceId, createdAt])
}
